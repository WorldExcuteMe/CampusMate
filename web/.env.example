# Frontend PUBLIC configuration. Do not put model/service-role secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional compatible AI endpoint. Default: same-origin /functions/v1/app.
VITE_AI_BASE_URL=

# Local model proxy: put LLM_API_KEY / LLM_BASE_URL / LLM_MODEL in .env.local.
# These unprefixed settings are read only by the local server, never the frontend.
# Production: configure server secrets instead; see docs/AI_BACKEND_SETUP.md.
