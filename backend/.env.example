# API and Worker must share database, JWT secret and credential key versions.
SUPABASE_JWT_SECRET=
DATABASE_URL=
# IPv4 persistent Supabase backends can use the shared SESSION pooler on 5432.
# Keep TLS CA/hostname verification; transaction-pooler mode is not this setting.
# Optional explicit HTTP(S) CONNECT proxy for Postgres (for example a loopback system proxy).
DATABASE_PROXY_URL=
# Optional finite connection acquisition timeout (100–30000ms); proxy default 15000, direct 8000.
# Acquisition retries once. Explicit pure reads may retry; writes/transactions never replay.
DATABASE_CONNECTION_TIMEOUT_MS=
# Supabase CA downloaded from the project's Database Settings; path relative to backend/ or absolute.
# Keep SSL parameters out of DATABASE_URL when supplying this CA.
DATABASE_SSL_CA_FILE=
PORT=8788
# Optional operator-provided default model; BYOK works without a default key.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_DISPLAY_NAME=
LLM_CONTEXT_LIMIT=
# Populate only capabilities verified for this endpoint, not guessed from model name.
# Verified DeepSeek thinking/tool endpoint example:
# {"tools":"native","reasoning":"deepseek_thinking","outputParameter":"max_tokens"}
LLM_CAPABILITIES={}
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2
# Required to save user keys: 32 random bytes in base64 or hex, server only.
PROVIDER_MASTER_KEY=
PROVIDER_KEY_VERSION=v1
# Optional map of prior versions to decryption keys during controlled rotation.
PROVIDER_DECRYPTION_KEYS={}
